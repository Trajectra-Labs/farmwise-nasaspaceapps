{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true, "isolatedModules": true, "skipLibCheck": true, "noEmit": true, "allowImportingTsExtensions": false,
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"],
    "paths": {
      "@fw/contracts": ["./harness/contracts/farmwise.ts"], "@fw/ui": ["./harness/ui/index.tsx"], "@fw/core": ["./harness/core/index.tsx"],
      "@fw/nasa": ["./harness/nasa/index.ts"], "@fw/simulated": ["./harness/simulated/index.ts"]
    }
  },
  "include": ["src", "harness", "tests", "vite.config.ts", "playwright.config.ts"]
}
